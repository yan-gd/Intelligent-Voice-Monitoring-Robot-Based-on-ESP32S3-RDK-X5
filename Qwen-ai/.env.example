# DashScope API key (required)
DASHSCOPE_API_KEY=your_dashscope_api_key

# Vision model name for behavior classification
VISION_MODEL=qwen3.6-flash

# Camera source: shared_jpeg reads frames published by tracking-face; usb opens /dev/video*
CAMERA_SOURCE=shared_jpeg
SHARED_FRAME_PATH=/tmp/rdk_shared_camera/latest.jpg
SHARED_FRAME_WAIT_SEC=5

# USB camera options (used only when CAMERA_SOURCE=usb)
CAMERA_INDEX=0
CAMERA_PROBE_MAX=6
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=30
CAMERA_FOURCC=MJPG

# Number of frames to drain before taking one snapshot (higher helps reduce lag)
CAMERA_DRAIN_FRAMES=16
# High-frequency camera capture thread interval in seconds (0.03 ~= 33fps)
CAPTURE_THREAD_INTERVAL_SEC=0.03

# Capture and upload tuning
# Capture interval in seconds (camera sampling speed)
CAPTURE_INTERVAL_SEC=1
# Uploaded image size for cloud inference
UPLOAD_WIDTH=640
UPLOAD_HEIGHT=288
# JPEG quality 30-95 (lower = smaller payload, faster)
UPLOAD_JPEG_QUALITY=45

# Cloud request timeout controls (seconds)
REQUEST_CONNECT_TIMEOUT_SEC=1.2
REQUEST_TIMEOUT_SEC=8

# Minimum interval between cloud inference requests (seconds)
INFER_MIN_INTERVAL_SEC=1

# Disable model reasoning mode to reduce latency (0/1)
THINKING_ENABLED=0

# Optional override: DashScope compatible API base URL
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local snapshot output directory
RUNTIME_DIR=runtime

